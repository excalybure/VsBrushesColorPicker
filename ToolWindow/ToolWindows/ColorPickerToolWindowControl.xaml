<UserControl x:Class="VsBrushesColorPicker.ColorPickerToolWindowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:platformUi="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
             MinHeight="380"
             MinWidth="280">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBox x:Name="FilterBox"
                 Margin="0,0,0,6"
                 VerticalContentAlignment="Center"
                 TextChanged="FilterBox_TextChanged" />
        <ListBox x:Name="ColorList"
                 Grid.Row="1"
                 SelectionChanged="ColorList_SelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel LastChildFill="True">
                        <Border Width="22"
                                Height="22"
                                Background="{Binding Brush}"
                                BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                                BorderThickness="1"
                                Margin="0,0,6,0" />
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Border Grid.Row="2"
                BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}"
                BorderThickness="1"
                Padding="6"
                Margin="0,8,0,0">
            <StackPanel Orientation="Vertical">
                <Border x:Name="Preview"
                        Height="64"
                        BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                        BorderThickness="1"
                        Margin="0,0,0,6" />
                <TextBlock x:Name="NameText" FontWeight="SemiBold" />
                <TextBlock x:Name="ClassText" Margin="0,2,0,0" />
                <TextBlock x:Name="TypeText" Margin="0,2,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
