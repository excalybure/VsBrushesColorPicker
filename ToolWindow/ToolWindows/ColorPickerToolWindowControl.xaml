<UserControl x:Class="VsBrushesColorPicker.ColorPickerToolWindowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:platformUi="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
             MinHeight="380"
             MinWidth="280">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="FilterBox"
                      Grid.Column="0"
                      Margin="0,0,4,0"
                      IsEditable="True"
                      VerticalContentAlignment="Center"
                      KeyUp="FilterBox_KeyUp"
                      SelectionChanged="FilterBox_SelectionChanged" />
            <Button x:Name="RefreshButton"
                    Grid.Column="1"
                    Width="24"
                    Height="24"
                    Content="⟳"
                    ToolTip="Refresh colors"
                    Click="RefreshButton_Click" />
        </Grid>
        <ListBox x:Name="ColorList"
                 Grid.Row="1"
                 SelectionChanged="ColorList_SelectionChanged"
                 PreviewKeyDown="ColorList_PreviewKeyDown">
            <ListBox.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Copy Color Name" 
                              InputGestureText="Ctrl+C"
                              Click="CopyColorName_Click" />
                    <MenuItem Header="Copy ARGB Value" 
                              Click="CopyArgbValue_Click" />
                </ContextMenu>
            </ListBox.ContextMenu>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel LastChildFill="True">
                        <Border Width="22"
                                Height="22"
                                Background="{Binding Brush}"
                                BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                                BorderThickness="1"
                                Margin="0,0,6,0" />
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Border Grid.Row="2"
                BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}"
                BorderThickness="1"
                Padding="6"
                Margin="0,8,0,0">
            <StackPanel Orientation="Vertical">
                <Border x:Name="Preview"
                        Height="64"
                        BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                        BorderThickness="1"
                        Margin="0,0,0,6" />
                <TextBlock x:Name="NameText" FontWeight="SemiBold" />
                <TextBlock x:Name="ArgbText" Margin="0,2,0,0" FontFamily="Consolas" />
                <TextBlock x:Name="ClassText" Margin="0,2,0,0" />
                <TextBlock x:Name="TypeText" Margin="0,2,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
